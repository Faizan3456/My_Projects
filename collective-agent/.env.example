# Copy to .env and fill in whatever you have. The system runs with zero keys —
# the offline "echo" agent exercises the full memory + handover loop — and each
# provider becomes selectable in the dashboard as soon as its key is present.

# --- database ---------------------------------------------------------------
# Host value for running the backend on your machine. docker-compose overrides
# this to use the "db" service hostname.
DATABASE_URL=postgresql+asyncpg://collective:collective@localhost:5432/collective
POSTGRES_USER=collective
POSTGRES_PASSWORD=collective
POSTGRES_DB=collective

# --- service ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DB_AUTO_CREATE=true

# --- authentication ---------------------------------------------------------
# "entra" | "token" | "disabled". Local development runs open; the app refuses to
# start with "disabled" when ENVIRONMENT=production.
AUTH_MODE=disabled

# To try Entra sign-in locally, set AUTH_MODE=entra plus these, and put the same
# two ids in frontend/.env.local as NEXT_PUBLIC_ENTRA_TENANT_ID / _CLIENT_ID.
# The registration already allows http://localhost:3000 as a redirect URI.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional allow list of UPNs or object ids; empty means anyone in the tenant.
ENTRA_ALLOWED_USERS=

# Shared secret for scripts (X-Service-Token). openssl rand -hex 32
SERVICE_TOKEN=

# How many past events are pasted into each agent prompt.
PROMPT_HISTORY_LIMIT=12
SUMMARY_MAX_CHARS=600
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=2048

# --- agents -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Copilot-branded models are reached through GitHub Models (OpenAI wire format).
GITHUB_TOKEN=
COPILOT_MODEL=gpt-4o

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Any OpenAI-compatible local server, e.g. http://localhost:11434/v1 for Ollama.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.1

# Offline connector for demos and tests. Safe to leave on.
ENABLE_ECHO_CONNECTOR=true

# --- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
