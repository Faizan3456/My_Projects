# Copy to deploy/.env.prod ON THE SERVER and fill in. Never commit the real file.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# --- site -------------------------------------------------------------------
SITE_DOMAIN=agents.openedgetechnologies.com

# --- database ---------------------------------------------------------------
POSTGRES_USER=collective
POSTGRES_DB=collective
# Generate one, do not reuse anything:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# --- authentication ---------------------------------------------------------
# Values below are the real app registration created in the OPENEDGETECHNOLOGIES
# tenant ("Collective AI Agent System"). They are identifiers, not secrets.
AUTH_MODE=entra
ENTRA_TENANT_ID=e9ba7eeb-8895-4350-8157-d17f5f523df3
ENTRA_CLIENT_ID=403dfa3f-e031-4bbc-aa98-4884ae230c23

# Optional: restrict to specific accounts. Empty means any account in the tenant.
# ENTRA_ALLOWED_USERS=Faizan.Fayyaz@openedgetechnologies.onmicrosoft.com

# For scripts and cron (X-Service-Token header). This one IS a secret:
#   openssl rand -hex 32
SERVICE_TOKEN=CHANGE_ME

# --- agents -----------------------------------------------------------------
# Every key here is spendable money. Leave blank to keep an agent switched off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GITHUB_TOKEN=
COPILOT_MODEL=gpt-4o

# --- free tiers (no card required) ---
# Groq: fastest hosted option, genuine free tier. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: one key, many models; ":free" ids cost nothing but are rate-limited.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.1

# Offline connector. Handy for proving the deployment works before spending money.
ENABLE_ECHO_CONNECTOR=true

# --- service ----------------------------------------------------------------
LOG_LEVEL=INFO
PROMPT_HISTORY_LIMIT=12
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=8000
